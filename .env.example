# ============================================
# Environment
# ============================================
NODE_ENV=production

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/elegardens
# DATABASE_URL_VERCEL=xx  # Optional: for Vercel deployments

# ============================================
# Payload CMS Configuration
# ============================================
# Secret key for signing tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PAYLOAD_SECRET=your-secret-key-here

# ============================================
# Server URL Configuration (CRITICAL FOR IP-BASED ACCESS)
# ============================================
# SERVER_URL: Used by server-side code to make internal API calls
# NEXT_PUBLIC_PAYLOAD_URL: Used by browser for client-side API calls
#
# For VPS with IP-only access (no domain):
#   SERVER_URL=http://YOUR_VPS_IP:3000
#   NEXT_PUBLIC_PAYLOAD_URL=http://YOUR_VPS_IP:3000
#   COOKIE_SECURE=false
#
# For production with domain:
#   SERVER_URL=https://yourdomain.com
#   NEXT_PUBLIC_PAYLOAD_URL=https://yourdomain.com
#   COOKIE_SECURE=true
#
SERVER_URL=http://localhost:3000
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# ============================================
# Cookie Configuration
# ============================================
# Set to false for HTTP-only deployments (VPS IP access without domain)
# Set to true for HTTPS deployments only
# If not set, defaults to: process.env.NODE_ENV === 'production'
# COOKIE_SECURE=false

# ============================================
# Email Configuration (Resend)
# ============================================
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=info@elegardens.com

# Email recipients
ORDERS_EMAIL_RECIPIENT=orders@elegardens.com
CONTACT_FORM_RECIPIENT=contact@elegardens.com

# ============================================
# Optional: Video Configuration
# ============================================
NEXT_PUBLIC_HOME_VIDEO_URL=
NEXT_PUBLIC_HOME_VIDEO_TITLE=Elegardens