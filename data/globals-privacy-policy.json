              "children": [
                {
                  "mode": "normal",
                  "text": "Nach der Datenschutz-Grundverordnung (DSGVO) haben Sie folgende Rechte bezüglich Ihrer personenbezogenen Daten:",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
