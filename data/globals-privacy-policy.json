                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<strong>Wie erfassen wir Ihre Daten?</strong>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Ihre Daten werden erhoben, wenn Sie uns diese freiwillig mitteilen. Dies umfasst Daten, die Sie in unser Kontaktformular eingeben (Name, E-Mail, Telefonnummer, Nachricht) oder wenn Sie unseren Newsletter abonnieren (E-Mail-Adresse).",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            }
          ],
          "direction": null
        }
      }
    },
    {
      "id": "69751281af55b6148121541c",
      "title_en": "3. General Information and Data Protection",
      "title_de": "3. Allgemeine Hinweise und Datenschutz",
      "content_en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "We take the protection of your personal data very seriously. We treat your personal data confidentially and in accordance with the EU General Data Protection Regulation (GDPR) and this privacy policy. Your data will only be used for the purposes stated in this policy and will not be shared with third parties without your consent, except where required by law.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            }
          ],
          "direction": null
        }
      },
      "content_de": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Wir nehmen den Schutz Ihrer persönlichen Daten sehr ernst. Wir behandeln Ihre personenbezogenen Daten vertraulich und entsprechend der Datenschutz-Grundverordnung (DSGVO) und dieser Datenschutzerklärung. Ihre Daten werden nur für die in dieser Erklärung genannten Zwecke verwendet und nicht ohne Ihre Einwilligung an Dritte weitergegeben, es sei denn, dies ist gesetzlich vorgeschrieben.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            }
          ],
          "direction": null
        }
      }
    },
    {
      "id": "69751291af55b6148121541e",
      "title_en": "4. Cookies and Cookie Consent",
      "title_de": "4. Cookies und Cookie-Einwilligung",
      "content_en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<strong>Cookie Usage</strong>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Our website uses cookies to enhance your browsing experience and ensure the website functions properly. We use a cookie consent management system that allows you to control which cookies are stored on your device. Cookies are small text files stored on your device that do not harm your computer and do not contain viruses.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<strong>We use the following types of cookies:</strong>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<ul>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li><strong>Necessary Cookies:</strong> These cookies are essential for the website to function properly and cannot be disabled. They are usually set in response to actions made by you, such as setting your privacy preferences.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li><strong>Marketing Cookies:</strong> These cookies are used to track visitors across websites for marketing purposes. You can choose to accept or reject these cookies through our cookie consent banner.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "</ul>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "You can manage your cookie preferences at any time by clicking on the cookie consent banner or using the 'Customize' option. Your consent choices are stored locally in your browser.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            }
          ],
          "direction": null
        }
      },
      "content_de": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<strong>Cookie-Verwendung</strong>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Unsere Website verwendet Cookies, um Ihr Browsing-Erlebnis zu verbessern und sicherzustellen, dass die Website ordnungsgemäß funktioniert. Wir verwenden ein Cookie-Einwilligungsverwaltungssystem, das es Ihnen ermöglicht zu kontrollieren, welche Cookies auf Ihrem Gerät gespeichert werden. Cookies sind kleine Textdateien, die auf Ihrem Gerät gespeichert werden und Ihrem Computer keinen Schaden zufügen und keine Viren enthalten.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<strong>Wir verwenden die folgenden Arten von Cookies:</strong>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<ul>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li><strong>Erforderliche Cookies:</strong> Diese Cookies sind für das ordnungsgemäße Funktionieren der Website unerlässlich und können nicht deaktiviert werden. Sie werden normalerweise als Reaktion auf von Ihnen durchgeführte Aktionen gesetzt, wie z.B. das Festlegen Ihrer Datenschutzeinstellungen.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li><strong>Marketing-Cookies:</strong> Diese Cookies werden verwendet, um Besucher über Websites hinweg für Marketingzwecke zu verfolgen. Sie können sich entscheiden, diese Cookies über unser Cookie-Einwilligungsbanner zu akzeptieren oder abzulehnen.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "</ul>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Sie können Ihre Cookie-Einstellungen jederzeit verwalten, indem Sie auf das Cookie-Einwilligungsbanner klicken oder die Option 'Anpassen' verwenden. Ihre Einwilligungsauswahl wird lokal in Ihrem Browser gespeichert.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            }
          ],
          "direction": null
        }
      }
    },
    {
      "id": "697512a4af55b61481215420",
      "title_en": "5. Your Rights Under GDPR",
      "title_de": "5. Ihre Rechte nach der DSGVO",
      "content_en": {
        "root": {
          "type": "root",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "Under the General Data Protection Regulation (GDPR), you have the following rights regarding your personal data:",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<ul>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li>Right of access: You have the right to request information about the personal data we hold about you.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li>Right to rectification: You can request correction of inaccurate or incomplete personal data.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li>Right to erasure: You can request deletion of your personal data under certain circumstances.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li>Right to restrict processing: You can request restriction of processing of your personal data.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li>Right to data portability: You can request transfer of your data to another service provider.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "<li>Right to object: You can object to processing of your personal data for certain purposes.</li>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "</ul>",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": null,
              "textStyle": "",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "To exercise any of these rights, please contact us at ",
                  "type": "text",
                  "style": "",
